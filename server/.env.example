# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ums

# JWT (use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7

# Firebase service account key (JSON) encoded as ONE base64 line:
#   node -e "console.log(require('fs').readFileSync('serviceAccountKey.json').toString('base64'))"
FIREBASE_SERVICE=

# ImgBB (profile photo upload) - optional, signup works without it
IMGBB_API_KEY=
